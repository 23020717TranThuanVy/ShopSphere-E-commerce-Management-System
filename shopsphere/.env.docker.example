# Replace both values with strong local development passwords.
# SQL Server requires at least 8 characters with 3 of: uppercase, lowercase, digits, symbols.
DB_SA_PASSWORD=ChangeThis_SaPassword_2026!
DB_APP_PASSWORD=ChangeThis_AppPassword_2026!

# Optional bootstrap administrator for managing products and categories.
# Fill these with a unique email and password of at least 12 characters.
SHOPSPHERE_ADMIN_EMAIL=
SHOPSPHERE_ADMIN_PASSWORD=

# Keep false for local HTTP. Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
